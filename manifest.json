{
  "manifest_version": 3,
  "name": "Lanis Helper",
  "version": "1.4.0",
  "description": "Lanis 게임을 위한 도우미 확장프로그램",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://lanis.me/*",
    "https://laniswiki.lovestoblog.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lanis.me/*",
        "https://laniswiki.lovestoblog.com/*",
        "https://laniswiki.lovestoblog.com/api.php*"
      ],
      "js": [
        "utils.js",
        "item-colors.js",
        "menu-module/menu-manager.js",
        "search-engine.js", 
        "item-stats.js",
        "menu-module/settings-modal.js",
        "user-profile.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "utils.js",
        "item-colors.js",
        "menu-module/menu-config.json",
        "menu-module/menu-manager.js",
        "search-engine.js",
        "item-stats.js",
        "menu-module/settings-modal.js",
        "user-profile.js",
        "rare-items.json"
      ],
      "matches": [
        "https://lanis.me/*",
        "https://laniswiki.lovestoblog.com/*"
      ]
    }
  ],
  "icons": {
    "16": "img/lanis16.png",
    "128": "img/lanis128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lanis Helper"
  },
  "background": {
    "service_worker": "background.js"
  }
}
